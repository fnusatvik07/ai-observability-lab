# Copy to .env and fill in. Never commit .env.

OPENAI_API_KEY=sk-...

# Local Langfuse: these match the headless-init keys in langfuse/.env.example
LANGFUSE_PUBLIC_KEY=pk-lf-local-demo-public
LANGFUSE_SECRET_KEY=sk-lf-local-demo-secret
LANGFUSE_BASE_URL=http://localhost:3000

# LangSmith (optional, notebook 04 and demo/langsmith_demo.py)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=ai-observability-lab

# Plain OpenTelemetry target for demo/otel_demo.py (pick one)
# Langfuse: base64 of "public_key:secret_key"
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20cGstbGYtbG9jYWwtZGVtby1wdWJsaWM6c2stbGYtbG9jYWwtZGVtby1zZWNyZXQ=,x-langfuse-ingestion-version=4
